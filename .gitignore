!/README.txt
!/send.js
!/package.json
!/package-lock.json
!/1-INSTALL.bat
!/2-CHECK-LIST.bat
!/3-SEND.bat
!/contacts-template.csv
!/pics/
/pics/*
!/pics/sample1.png
!/pics/sample2.png
